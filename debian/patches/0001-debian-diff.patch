+    public static boolean driverSupported(String driverName) {
+        for (JCloudBlobStoreProvider provider: JCloudBlobStoreProvider.values()) {
+            if (provider.getDriver().equalsIgnoreCase(driverName)) {
+                return true;
+            }
+        }
+        return false;
+    }
