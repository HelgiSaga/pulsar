+            byte[] b = new byte[4];
+            int ret = inputStream.read(b, 0, 4);
+            assertEquals(ret, -1);
+        }
+        assertEquals(inputStream.read(), -1);
+
+        assertEquals(inputStream.getBlockEntryCount(), 0);
+        assertEquals(inputStream.getBlockEntryBytesCount(), 0);
+        assertEquals(inputStream.getEndEntryId(), -1);
+
+        inputStream.close();
