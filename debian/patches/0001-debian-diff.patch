+    public void delay(long millis, BiPredicate<Op, String> predicate) {
+        failures.add(new Failure(null, (op, s) -> {
+            if (predicate.test(op, s)) {
+                try {
+                    Thread.sleep(millis);
+                } catch (InterruptedException e) {}
+                return true;
+            }
+            return false;
+        }));
+    }
