+
+# Server Private Key
+openssl ecparam -name secp256r1 -genkey  -out server.key.pem
+# Convert to pkcs8
+openssl pkcs8 -topk8 -inform PEM -outform PEM -in server.key.pem -out server.key-pk8.pem -nocrypt
+# Request certificate  
