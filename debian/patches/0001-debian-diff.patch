-        if (outputTypeClassName != null) {
-            generator.setOutputTypeClassName(outputTypeClassName);
-        }
-        if (commandGeneratorConsumer != null) {
-            commandGeneratorConsumer.accept(generator);
-        }
-        String command = "";
-
-        switch (runtime) {
-            case JAVA:
-                command = generator.generateCreateFunctionCommand();
-                break;
