-        if (tree.containsKey(path)) {
-            throw new KeeperException.NodeExistsException(path);
-        }
-
-        MockZNode parentNode = tree.get(parent);
-
-        if (parentNode == null) {
-            throw new KeeperException.NoNodeException(parent);
-        }
-
-        if (createMode.isSequential()) {
