+    void maybeThrowProgrammedFailure(Op op, String path) throws KeeperException {
+        Optional<KeeperException.Code> failure = programmedFailure(op, path);
+        if (failure.isPresent()) {
+            throw KeeperException.create(failure.get());
+        }
+    }
