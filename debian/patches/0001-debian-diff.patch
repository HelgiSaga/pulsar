+                "--tenant", tenant,
+                "--namespace", namespace,
+                "--name", sourceName
+        };
+
+        ContainerExecResult result = pulsarCluster.getAnyWorker().execCmd(commands);
+        log.info("Get source info : {}", result.getStdout());
+        assertTrue(
+                result.getStdout().contains("\"archive\": \"builtin://" + SOURCE_TYPE + "\""),
+                result.getStdout()
+        );
